{
  "name": "poohma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@poohma/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:show": "turbo run test:e2e:show",
    "typecheck": "turbo run typecheck",
    "check": "biome check --write",
    "check:ci": "biome ci",
    "verify": "pnpm typecheck && pnpm check && pnpm test && pnpm build",
    "web": "pnpm -F @poohma/web",
    "convex:dev": "pnpm web exec convex dev",
    "convex:dev:once": "pnpm web exec convex dev --once && pnpm check",
    "convex:sync": "pnpm web exec convex deploy && pnpm web exec convex codegen && pnpm check",
    "convex:codegen": "pnpm web exec convex codegen && pnpm check",
    "convex:deploy": "pnpm web exec convex deploy",
    "prepreview": "pnpm -F @poohma/web exec playwright test e2e/auth.setup.ts --project=setup --no-deps",
    "preview": "pnpm -F @poohma/web exec playwright open --load-storage=e2e/.auth/e2e-user.json --ignore-https-errors https://localhost:3000/dashboard --device=\"iPhone 17\" --color-scheme=light"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "turbo": "^2.5.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
