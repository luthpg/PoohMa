{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**/*",
      "convex/**/*",
      ".storybook/**/*",
      "*.config.*",
      ".*",
      "tests/**/*",
      "e2e/**/*",
      "scripts/**/*",
      "**/.vscode/**/*",
      "**/index.html",
      "**/vite.config.ts",
      "!**/src/routeTree.gen.ts",
      "!**/src/styles.css",
      "!**/coverage/**/*"
    ]
  }
}
